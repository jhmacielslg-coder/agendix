# Variáveis de ambiente para conexão com o Supabase
# Substitua com a URL e Chave Pública Anônima do seu projeto Supabase caso deseje conectar ao banco em nuvem.

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Se estas chaves não forem preenchidas, o Agendix roda automaticamente em modo local com persistência total via LocalStorage e banco reativo.
